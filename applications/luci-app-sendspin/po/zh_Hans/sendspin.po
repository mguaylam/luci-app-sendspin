#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:141
msgid "%s is requesting to pair with this player."
msgstr "%s 正在请求与此播放器配对。"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:66
#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:142
msgid "A server is requesting to pair with this player."
msgstr "有服务器正在请求与此播放器配对。"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:286
msgid "ALSA device to play through. A <code>hw:</code> device plays without resampling."
msgstr "用于播放的 ALSA 设备。<code>hw:</code> 设备直接播放，不重采样。"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:277
msgid "Advanced Settings"
msgstr "高级设置"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:229
msgid "All"
msgstr "全部"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:336
msgid "Allow unpaired servers"
msgstr "允许未配对的服务器"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:100
msgid "Alternative to the pairing code, for servers that accept a pairing token. Treat it as a password."
msgstr "配对码的替代方式，适用于接受配对令牌的服务器。请像对待密码一样保管。"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:326
