msgstr "Comando non riuscito"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:333
msgid "Connect to this server, as <code>host[:port]</code>, instead of waiting to be discovered."
msgstr "Connettiti a questo server, come <code>host[:porta]</code>, invece di attendere di essere rilevato."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:337
msgid "Connections are always encrypted. When enabled, any server on the network can play without pairing."
msgstr "Le connessioni sono sempre cifrate. Se attivato, qualsiasi server della rete può riprodurre senza associazione."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:30
msgid "Copied"
msgstr "Copiato"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:31
#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:33
msgid "Copy"
msgstr "Copia"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:344
msgid "Debug"
msgstr "Debug"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/sendspin.js:102
msgid "Disabled"
msgstr "Disattivato"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:279
