#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:141
msgid "%s is requesting to pair with this player."
msgstr "%s запрашивает сопряжение с этим плеером."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:66
#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:142
msgid "A server is requesting to pair with this player."
msgstr "Сервер запрашивает сопряжение с этим плеером."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:286
msgid "ALSA device to play through. A <code>hw:</code> device plays without resampling."
msgstr "Устройство ALSA для воспроизведения. Устройство <code>hw:</code> воспроизводит без передискретизации."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:277
msgid "Advanced Settings"
msgstr "Дополнительные настройки"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:229
msgid "All"
msgstr "Все"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:336
msgid "Allow unpaired servers"
msgstr "Разрешить несопряжённые серверы"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:100
msgid "Alternative to the pairing code, for servers that accept a pairing token. Treat it as a password."
msgstr "Альтернатива коду сопряжения для серверов, принимающих токен сопряжения. Обращайтесь с ним как с паролем."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:326
msgid "Announce over mDNS"
msgstr "Объявлять через mDNS"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:61
#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:158
msgid "Approve"
msgstr "Подтвердить"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:312
msgid "Audio kept buffered by the device, in milliseconds."
msgstr "Объём звука в буфере устройства, в миллисекундах."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:311
msgid "Buffer"
msgstr "Буфер"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/sendspin.js:144
msgid "Card %d"
msgstr "Карта %d"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:153
msgid "Close"
msgstr "Закрыть"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/sendspin.js:78
msgid "Command failed"
msgstr "Команда не выполнена"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:333
msgid "Connect to this server, as <code>host[:port]</code>, instead of waiting to be discovered."
msgstr "Подключаться к этому серверу, в виде <code>хост[:порт]</code>, вместо ожидания обнаружения."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:337
msgid "Connections are always encrypted. When enabled, any server on the network can play without pairing."
msgstr "Соединения всегда шифруются. Если включено, любой сервер в сети может воспроизводить без сопряжения."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:30
msgid "Copied"
msgstr "Скопировано"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:31
#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:33
msgid "Copy"
msgstr "Копировать"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:344
msgid "Debug"
msgstr "Отладка"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/sendspin.js:102
msgid "Disabled"
msgstr "Отключён"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:279
msgid "Enable"
msgstr "Включить"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:54
#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:152
msgid "Enter this code in the server to complete pairing."
msgstr "Введите этот код на сервере, чтобы завершить сопряжение."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:341
msgid "Error"
msgstr "Ошибка"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:301
msgid "Expected a comma-separated list of codec:rate:depth:channels, with codec flac, opus or pcm"
msgstr "Ожидался список через запятую вида кодек:частота:биты:каналы, с кодеком flac, opus или pcm"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:292
msgid "Formats offered to the server first, as a comma-separated list of <code>codec:rate:depth:channels</code>, e.g. <code>flac:48000:16:2,pcm:48000:16:2</code>. The device's other formats stay behind them, so this is a preference the server can fall back from, not a restriction. Empty offers every format the device accepts."
msgstr "Форматы, предлагаемые серверу в первую очередь, в виде списка через запятую <code>кодек:частота:биты:каналы</code>, например <code>flac:48000:16:2,pcm:48000:16:2</code>. Остальные форматы устройства остаются доступными после них, так что это предпочтение, от которого сервер может отступить, а не ограничение. Пустое значение предлагает все форматы, которые принимает устройство."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:276
msgid "General Settings"
msgstr "Общие настройки"

#: applications/luci-app-sendspin/root/usr/share/rpcd/acl.d/luci-app-sendspin.json:3
msgid "Grant access to Sendspin player status, controls and configuration"
msgstr "Предоставляет доступ к состоянию, управлению и настройке проигрывателя Sendspin"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:211
msgid "Group volume"
msgstr "Громкость группы"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:343
msgid "Info"
msgstr "Информация"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:317
msgid "Latency added after the device, such as by an amplifier, in milliseconds. Only a first-run default: a delay set from the server is remembered."
msgstr "Задержка, добавляемая после устройства, например усилителем, в миллисекундах. Только начальное значение: задержка, заданная сервером, запоминается."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:327
msgid "Let a server discover the player. Ignored when a server address is set."
msgstr "Позволяет серверу обнаружить проигрыватель. Игнорируется, если задан адрес сервера."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:339
msgid "Log level"
msgstr "Уровень журнала"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:218
msgid "Mute"
msgstr "Выключить звук"

