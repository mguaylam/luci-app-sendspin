#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:81
msgid "Connect to this server, as <code>host[:port]</code>, instead of waiting to be discovered."
msgstr "Se connecter à ce serveur, sous la forme <code>host[:port]</code>, au lieu d’attendre d’être découvert."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:89
msgid "Debug"
msgstr "Débogage"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/sendspin.js:67
msgid "Disabled"
msgstr "Désactivé"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:40
