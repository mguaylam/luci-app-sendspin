#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:47
msgid "ALSA device to play through. A <code>hw:</code> device plays without resampling."
msgstr "Périphérique ALSA utilisé pour la lecture. Un périphérique <code>hw:</code> joue sans rééchantillonnage."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:38
msgid "Advanced Settings"
msgstr "Paramètres avancés"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:74
msgid "Announce over mDNS"
msgstr "Annoncer via mDNS"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:60
msgid "Audio kept buffered by the device, in milliseconds."
msgstr "Audio gardé en mémoire tampon par le périphérique, en millisecondes."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:59
msgid "Buffer"
msgstr "Tampon"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/sendspin.js:107
