msgstr "Activer"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:86
msgid "Error"
msgstr "Erreur"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:57
msgid "Expected codec:rate:depth:channels, with codec flac, opus or pcm"
msgstr "Format attendu : codec:fréquence:bits:canaux, où le codec est flac, opus ou pcm"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:53
msgid "Format offered to the server first, as <code>codec:rate:depth:channels</code>, e.g. <code>flac:48000:16:2</code>. Empty offers every format the device accepts."
msgstr "Format proposé en premier au serveur, sous la forme <code>codec:fréquence:bits:canaux</code>, par exemple <code>flac:48000:16:2</code>. Vide, tous les formats acceptés par le périphérique sont proposés."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:37
msgid "General Settings"
msgstr "Paramètres généraux"

#: applications/luci-app-sendspin/root/usr/share/rpcd/acl.d/luci-app-sendspin.json:3
msgid "Grant access to Sendspin player status and configuration"
msgstr "Donner accès à l’état et à la configuration du lecteur Sendspin"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:88
msgid "Info"
msgstr "Information"

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:65
msgid "Latency added after the device, such as by an amplifier, in milliseconds. Only a first-run default: a delay set from the server is remembered."
msgstr "Latence ajoutée après le périphérique, par exemple par un amplificateur, en millisecondes. Valeur initiale seulement : un délai réglé depuis le serveur est conservé."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:75
msgid "Let a server discover the player. Ignored when a server address is set."
msgstr "Permet à un serveur de découvrir le lecteur. Ignoré si une adresse de serveur est définie."

#: applications/luci-app-sendspin/htdocs/luci-static/resources/view/sendspin.js:84
msgid "Log level"
msgstr "Niveau de journalisation"

